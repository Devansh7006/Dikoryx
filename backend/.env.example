# ==============================================
# Dikoryx Backend Configuration (.env.example)
# Copy this file to backend/.env and customize.
# ==============================================

# Database Connection (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./dikoryx.db
# Example PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dikoryx?sslmode=require

# Agent Authentication
# Set to 'true' in production to enforce per-agent API keys
REQUIRE_AGENT_AUTH=false

# Optional Integrations
SMTP_EMAIL=
SMTP_PASSWORD=
ABUSEIPDB_KEY=
